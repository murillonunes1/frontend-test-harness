# Copie para .env e preencha. O .env nunca deve ser commitado.
# No CI, configure os mesmos nomes como Secrets do repositório.

# App/ambiente padrão quando --app/--env não são informados (opcional)
# APP=todomvc
# ENV=production

# Sobrescreve a URL do ambiente (ex.: preview deploy de um PR)
# BASE_URL=https://pr-123.preview.minha-app.com/
# API_URL=https://api.pr-123.preview.minha-app.com/

# saucedemo: credenciais PÚBLICAS da demo (exibidas na própria tela de login)
SAUCEDEMO_USER=standard_user
SAUCEDEMO_PASSWORD=secret_sauce

# Modelo para novas apps: <APP>_USER / <APP>_PASSWORD
# MINHA_APP_USER=
# MINHA_APP_PASSWORD=
